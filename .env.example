# DPN AI v5 local configuration
DPN_APP_NAME=DPN AI
DPN_HOST=127.0.0.1
DPN_PORT=8787
# Required for non-loopback API clients. Use a long random value.
DPN_ACCESS_TOKEN=

# Model gateway: local Ollama by default, optional OpenAI-compatible server
OLLAMA_URL=http://127.0.0.1:11434
DPN_DEFAULT_MODEL=qwen3.5:9b
DPN_DEFAULT_PROVIDER=ollama
DPN_COMPATIBLE_API_URL=
DPN_COMPATIBLE_API_SECRET=MODEL_PROVIDER_KEY
DPN_ALLOW_EXTERNAL_MODELS=false
DPN_PLANNER_MODEL=
DPN_WORKER_MODEL=
DPN_REVIEWER_MODEL=
DPN_EMBEDDING_MODEL=nomic-embed-text
DPN_THINK_LEVEL=medium
DPN_INTELLIGENCE_MODE=maximum
DPN_KEEP_MODEL_LOADED=true

# Agent and mission resource controls
DPN_MAX_AGENT_STEPS=14
DPN_MAX_MISSION_STEPS=12
DPN_MAX_HISTORY_MESSAGES=50
DPN_MAX_TOOL_CALLS=80
DPN_MAX_RUN_SECONDS=1800
DPN_COMMAND_TIMEOUT=120
DPN_MAX_TOOL_OUTPUT=32000

# Secure defaults; each can also be changed in the command center
DPN_ALLOW_COMMANDS=false
DPN_ALLOW_WEB=true
DPN_ALLOW_IMAGES=false
DPN_ALLOW_AUTOMATIONS=false
DPN_ALLOW_BROWSER=false
DPN_ALLOW_DESKTOP=false
DPN_ALLOW_VOICE=true
DPN_ALLOW_CONNECTORS=false
DPN_ALLOW_MCP=false
DPN_ALLOW_EXTERNAL_MCP=false
DPN_ALLOW_SELF_IMPROVEMENT=false
DPN_ALLOW_HOST_SANDBOX=false
DPN_MAX_PARALLEL_JOBS=2
DPN_REVIEW_QUORUM=2
DPN_ALLOW_PRIVATE_NETWORK=false

# Optional local ComfyUI image generation
COMFYUI_URL=http://127.0.0.1:8188
DPN_COMFYUI_WORKFLOW=data/comfyui_workflow_api.json